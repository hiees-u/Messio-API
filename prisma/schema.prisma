generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        Int      @id @default(autoincrement())
  email     String?   @unique
  name      String
  createdAt DateTime @default(now())
  facebookAccounts UserFacebook[]
}

model UserFacebook {
  id          Int      @id @default(autoincrement())
  facebookId  String   @unique
  name        String
  email       String?  @unique

  userId      Int?
  user        User?    @relation(fields: [userId], references: [id], onDelete: Cascade)

  picture     PictureUserFacebook?
  accessToken UserAccessToken?
  faceBookPage FaceBookPage[]
}

model PictureUserFacebook {
  id            Int      @id @default(autoincrement())
  height        Int
  isSilhouette Boolean
  url           String
  width         Int

  userFacebookId        Int @unique
  userFacebook          UserFacebook @relation(fields: [userFacebookId], references: [id], onDelete: Cascade)
}

model UserAccessToken {
  id        Int      @id @default(autoincrement())
  token     String   @unique
  expiresAt DateTime

  userFacebookId    Int @unique
  userFacebook      UserFacebook @relation(fields: [userFacebookId], references: [id], onDelete: Cascade)
}

model  FaceBookPage {
  id        Int     @id @default(autoincrement())
  token     String  @unique
  name      String
  tasks     String[]
  pageId String @unique

  userFacebookId  Int
  userFacebook UserFacebook @relation(fields: [userFacebookId], references: [id], onDelete: Cascade)

  rooms Rooms[]
}

model Customers {
  id        Int     @id @default(autoincrement())
  name      String
  psid      String  @unique

  rooms Rooms?
}

model Rooms {
  id       Int     @id @default(autoincrement())
  pageId   Int
  customerId Int   @unique

  page     FaceBookPage @relation(fields: [pageId], references: [id], onDelete: Cascade)
  customer Customers @relation(fields: [customerId], references: [id], onDelete: Cascade)
  messages Messages[]
  @@unique([pageId, customerId])
}

model Messages {
  id        Int     @id @default(autoincrement())
  mid       String  @unique
  roomId    Int
  readed    Boolean
  text      String
  type      String?

  room      Rooms @relation(fields: [roomId], references: [id], onDelete: Cascade)
}